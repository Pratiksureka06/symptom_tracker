# Copy this file to backend/.env and fill in your own key.
# backend/.env is gitignored — never commit a real key, and never put this key
# in the frontend, where it would ship to every visitor's browser.

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash (3.8/3.7 currently hang; 3.6 responds).
# Change this if that id is retired or not enabled on your key.
GEMINI_MODEL=

# Optional server settings.
PORT=3001
FRONTEND_URL=http://localhost:5173
